  "required": [
    "schema_version",
    "validity",
    "reason_codes",
    "generated_at",
    "scope",
    "expected_archive_sha256",
    "archive",
    "archive_metadata",
    "limits",
    "historical_references",
    "historical_claims",
    "current_verification",
    "execution_verification",
    "learning_verification",
    "mlflow_verification",
    "license_verification",
    "gates_verification",
    "gaps",
    "release_status"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltolini:mobile-decision:lineage-run:1",
  "title": "R1D.A — recibo estático e referências históricas pinadas",
  "description": "VALID verifica pin externo, metadata ZIP limitada e forma/vínculo dos refs. Não extrai ou executa membros, reaudita seus hashes/header, recalcula scorer, comprova treino, licenças, MLflow ou gate. Referências são explícitas: integrity/reaggregation JSON estritos ligados internamente a archive_sha256; provenance é associação externa. Argumentos da API são paths e hashes, sem defaults privados.",
  "allOf": [
    {
      "if": {
        "properties": {
          "validity": {
            "const": "INVALID"
          }
        }
      },
      "then": {
        "properties": {
          "archive_metadata": {
            "type": "null"
          },
          "historical_claims": {
            "maxProperties": 0
          },
          "historical_references": {
            "maxItems": 0
          },
          "current_verification": {
            "const": "NOT_VERIFIED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validity": {
            "const": "VALID"
          }
        }
      },
      "then": {
        "properties": {
          "archive_metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "members": {
                "type": "integer",
                "minimum": 0
              },
              "expanded_bytes_declared": {
                "type": "integer",
                "minimum": 0
              },
              "entries": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compressed_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compression": {
                      "enum": [
                        0,
                        8
                      ]
                    },
                    "directory": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "path",
                    "bytes",
                    "compressed_bytes",
                    "compression",
                    "directory"
                  ]
                }
              }
            },
            "required": [
              "members",
              "expanded_bytes_declared",
              "entries"
            ]
          },
          "expected_archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "file_modified_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes",
              "file_modified_at"
            ]
          },
          "current_verification": {
            "const": "ZIP_PIN_METADATA_AND_REFERENCE_LINKS_ONLY"
          }
        }
      }
    }
  ]
}
