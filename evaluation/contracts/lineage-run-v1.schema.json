          "properties": {
            "members": {
              "type": "integer",
              "minimum": 0
            },
            "expanded_bytes_declared": {
              "type": "integer",
              "minimum": 0
            },
            "entries": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
