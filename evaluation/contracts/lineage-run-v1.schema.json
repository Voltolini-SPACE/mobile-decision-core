    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archive_bytes": {
          "const": 8388608
        },
        "members": {
          "const": 1024
        },
        "member_bytes": {
          "const": 8388608
        },
        "expanded_bytes": {
          "const": 33554432
        },
        "expansion_ratio": {
          "const": 100
        },
        "path_bytes": {
          "const": 512
        }
      },
      "required": [
        "archive_bytes",
        "members",
        "member_bytes",
        "expanded_bytes",
        "expansion_ratio",
        "path_bytes"
      ]
    },
    "historical_references": {
