{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "voltolini.mobile-decision.case-metrics/1"
    },
    "validity": {
      "enum": [
        "VALID",
        "INVALID"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bundle_root": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "anyOf": [
        {
          "enum": [
            "fixture",
            "historical",
            "replay"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "source_updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "file_modified_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "file_modified_at"
        ]
      }
    },
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/counts"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accuracy_all": {
          "$ref": "#/$defs/ratio"
        },
        "accuracy_eligible": {
          "$ref": "#/$defs/ratio"
        },
        "accepted_accuracy": {
          "$ref": "#/$defs/ratio"
        },
        "coverage_eligible": {
          "$ref": "#/$defs/ratio"
        },
        "accepted_fraction_all": {
          "$ref": "#/$defs/ratio"
        }
      },
      "required": [
        "accuracy_all",
        "accuracy_eligible",
        "accepted_accuracy",
        "coverage_eligible",
        "accepted_fraction_all"
      ]
    },
    "bounds": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "$ref": "#/$defs/ratio"
                },
                "upper": {
                  "$ref": "#/$defs/ratio"
                }
              },
              "required": [
                "lower",
                "upper"
              ]
            },
            "eligible": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "$ref": "#/$defs/ratio"
                },
                "upper": {
                  "$ref": "#/$defs/ratio"
                }
              },
              "required": [
                "lower",
                "upper"
              ]
            }
          },
          "required": [
            "all",
            "eligible"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "arithmetic_identity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accepted_correct_fraction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unaccepted_correct_fraction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "accuracy": {
                      "type": "string",
                      "minLength": 1
                    },
                    "precision_times_coverage_defined": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "accepted_correct_fraction",
                    "unaccepted_correct_fraction",
                    "accuracy",
                    "precision_times_coverage_defined"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "eligible": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accepted_correct_fraction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unaccepted_correct_fraction": {
                      "type": "string",
                      "minLength": 1
                    },
                    "accuracy": {
                      "type": "string",
                      "minLength": 1
                    },
                    "precision_times_coverage_defined": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "accepted_correct_fraction",
                    "unaccepted_correct_fraction",
                    "accuracy",
                    "precision_times_coverage_defined"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "all",
            "eligible"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_verification": {
      "const": "NOT_VERIFIED"
    },
    "authentication_verification": {
      "const": "NOT_VERIFIED"
    },
    "label_freeze_verification": {
      "const": "NOT_VERIFIED"
    },
    "input_reference_content_verification": {
      "const": "NOT_VERIFIED"
    },
    "release_status": {
      "const": "NOT_APPROVED_FOR_RELEASE"
    },
    "policy_threshold_exact": {
      "type": [
        "string",
        "null"
      ],
      "description": "Fração exata usada no limiar; identity.threshold é a representação numérica JSON."
    }
  },
  "required": [
    "schema_version",
    "validity",
    "reason_codes",
    "bundle_root",
    "source_kind",
    "source_updated_at",
    "generated_at",
    "identity",
    "sources",
    "counts",
    "metrics",
    "bounds",
    "arithmetic_identity",
    "execution_verification",
    "authentication_verification",
    "label_freeze_verification",
    "input_reference_content_verification",
    "release_status",
    "policy_threshold_exact"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltolini:mobile-decision:case-metrics:1",
  "title": "EV4 — contagens e métricas de uma coorte categórica",
  "description": "VALID verifica estrutura, hashes e aritmética; não certifica inferência, autenticidade, cegamento ou release. Arquivos JSONL são objetos case/label/prediction separados; threshold comparado como decimal exato. Tipos none_matches não são suportados e invalidam toda a coorte. A identidade esperada precisa ser fornecida independentemente.",
  "allOf": [
    {
      "if": {
        "properties": {
          "validity": {
            "const": "INVALID"
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "type": "null"
          },
          "bounds": {
            "type": "null"
          },
          "arithmetic_identity": {
            "type": "null"
          },
          "identity": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validity": {
            "const": "VALID"
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "$ref": "#/$defs/counts"
          },
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "source_kind": {
            "enum": [
              "fixture",
              "historical",
              "replay"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokenizer_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protocol_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cases_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "labels_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "scorer": {
          "const": "opaque-id-exact-micro/1"
        },
        "policy": {
          "const": "eligible-ok-probability-gte/1"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "dataset_hash",
        "split_hash",
        "model_hash",
        "tokenizer_hash",
        "calibration_hash",
        "runtime_hash",
        "protocol_hash",
        "code_hash",
        "cases_sha256",
        "labels_sha256",
        "run_id",
        "cohort_id",
        "scorer",
        "policy",
        "threshold"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "N_all": {
          "type": "integer",
          "minimum": 0
        },
        "N_eligible": {
          "type": "integer",
          "minimum": 0
        },
        "N_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "N_correct_all": {
          "type": "integer",
          "minimum": 0
        },
        "N_correct_eligible": {
          "type": "integer",
          "minimum": 0
        },
        "N_correct_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "N_wrong_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "N_errors": {
          "type": "integer",
          "minimum": 0
        },
        "N_timeouts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "N_all",
        "N_eligible",
        "N_accepted",
        "N_correct_all",
        "N_correct_eligible",
        "N_correct_accepted",
        "N_wrong_accepted",
        "N_errors",
        "N_timeouts"
      ],
      "$comment": "validate_counts também aplica as desigualdades de subconjuntos, diferenças e erros/timeouts. JSON Schema sozinho não prova essas invariantes."
    },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exact": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value",
        "exact",
        "reason"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "voltolini.mobile-decision.case-bundle/1"
        },
        "source_kind": {
          "enum": [
            "fixture",
            "historical",
            "replay"
          ]
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "freeze_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cases": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            },
            "predictions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            }
          },
          "required": [
            "cases",
            "labels",
            "predictions"
          ]
        },
        "declared_counts": {
          "$ref": "#/$defs/counts"
        }
      },
      "required": [
        "schema_version",
        "source_kind",
        "source_updated_at",
        "freeze_reference",
        "identity",
        "artifacts"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "input_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eligible": {
          "type": "boolean"
        },
        "eligibility_reason": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "option"
              },
              "description_ref": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
              },
              "description_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "description_ref",
              "description_sha256"
            ]
          }
        }
      },
      "required": [
        "case_id",
        "input_ref",
        "input_sha256",
        "eligible",
        "eligibility_reason",
        "alternatives"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "case_id",
        "expected_id"
      ]
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "ok",
            "error",
            "timeout"
          ]
        },
        "predicted_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "probability": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "detail_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000]).+[^/]$|^[^./\\\\\\u0000]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "case_id",
        "run_id",
        "cohort_id",
        "input_sha256",
        "outcome",
        "predicted_id",
        "selected_id",
        "accepted",
        "probability",
        "reason",
        "detail_ref",
        "identity"
      ]
    }
  }
}
